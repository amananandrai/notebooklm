{
  "rewrites": [
    {
      "source": "/api/hyperframes/render",
      "destination": "/api/hyperframes-render.js"
    },
    {
      "source": "/api/hyperframes/render/(.*)",
      "destination": "/api/hyperframes-status.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|mcp).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hyperframes-render.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/hyperframes-status.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

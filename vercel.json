{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/hyperframes-render.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/hyperframes-render.js"]
      }
    },
    {
      "src": "api/hyperframes-status.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/hyperframes/render",
      "dest": "api/hyperframes-render.js"
    },
    {
      "src": "/api/hyperframes/render/(.*)",
      "dest": "api/hyperframes-status.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/mcp",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/hyperframes-render.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/hyperframes-status.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

# ── AI model (required) ───────────────────────────────────
# Default provider is Gemini; only GEMINI_API_KEY is needed.
GEMINI_API_KEY=
# To use another provider instead (see README "Using a different AI model"):
# LLM_PROVIDER=openai_compat        # gemini | openai_compat | anthropic
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODELS=model-a,model-b        # ordered fallback chain
# LLM_CONDENSE_MODEL=               # optional cheaper model for long-document condensing
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_TIMEOUT_S=90
# Context budgets in characters (~4 chars per token); lower for small-context models
# LLM_MAX_DIRECT_CHARS=60000
# LLM_CHUNK_CHARS=12000
# LLM_CHAT_CONTEXT_CHARS=30000

# ── Access (required on Vercel) ───────────────────────────
# Comma-separated access keys, one per person/team. Each key gets its own
# private workspace. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Unset locally = auth disabled (dev only). Unset on Vercel = all requests refused.
APP_ACCESS_KEYS=

# ── Storage ───────────────────────────────────────────────
# MongoDB connection string, or "memory" for a throwaway in-memory DB (local dev).
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=notebooklm_studio
MONGO_TIMEOUT_MS=3000
# Vercel Blob token: generated images are stored there (optional)
BLOB_READ_WRITE_TOKEN=
# Days to keep cached generation results
CACHE_TTL_DAYS=30

# ── Network & limits ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only behind a proxy you control (trusts X-Forwarded-For)
TRUST_PROXY=false
# auto = MongoDB on Vercel (shared across instances), memory elsewhere
RATE_LIMIT_STORE=auto
RATE_LIMIT_GENERAL_PER_MIN=240
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AI_PER_HOUR=200
RATE_LIMIT_TTS_PER_MIN=10
RATE_LIMIT_AUTH_FAIL_PER_5MIN=10
# Vercel rejects request bodies over ~4.5 MB anyway
MAX_REQUEST_BYTES=4194304
MAX_DOCUMENT_CHARS=600000
# Seconds between heartbeats on streamed generation responses
JOB_HEARTBEAT_S=10

# ── Narration for the 3D Video Studio (text-to-speech) ───
# Unset = auto: Windows SAPI on Windows, else Gemini TTS when GEMINI_API_KEY is
# set, else espeak-ng if installed. Force one with: sapi | gemini | espeak
TTS_BACKEND=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE_A=Puck
GEMINI_TTS_VOICE_B=Kore

# ── Frontend (build time) ─────────────────────────────────
# API origin for the web app; default: same origin, or http://127.0.0.1:8080 on localhost
# VITE_API_ORIGIN=

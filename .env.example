# ── Required ──────────────────────────────────────────────
GEMINI_API_KEY=
# Comma-separated access keys, one per person/team. Each key gets its own
# private workspace. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Unset locally = auth disabled (dev only). Unset on Vercel = all requests refused.
APP_ACCESS_KEYS=

# ── Optional ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=notebooklm_studio
# Extra browser origins allowed to call the API cross-origin (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when running behind a proxy you control (trusts X-Forwarded-For)
TRUST_PROXY=0

# Rate limits (per access key, or per IP when auth is off)
RATE_LIMIT_GENERAL_PER_MIN=240
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AI_PER_HOUR=200
RATE_LIMIT_TTS_PER_MIN=10
RATE_LIMIT_RENDER_PER_HOUR=10
RATE_LIMIT_AUTH_FAIL_PER_5MIN=10
MAX_CONCURRENT_RENDERS=2
MAX_REQUEST_BYTES=8388608
MAX_DOCUMENT_CHARS=600000
